{
  // ตั้งค่าให้ Cloudflare Worker เสิร์ฟไฟล์ static ที่ Vite บิลด์ออกมา
  // ชื่อ name ต้องตรงกับชื่อ Worker ในแดชบอร์ด Cloudflare
  "name": "flukesociety",
  "compatibility_date": "2026-08-24",
  "assets": {
    // โฟลเดอร์ผลลัพธ์จาก `npm run build`
    "directory": "./dist",
    // path ที่ไม่มีอยู่จริงให้ได้หน้า public/404.html พร้อมสถานะ 404
    // (เดิมเป็นโหมด SPA ซึ่งส่งหน้าแรกกลับไปพร้อมสถานะ 200 ให้ทุก URL ที่พิมพ์ผิด
    //  Google จะเห็นเป็นหน้าซ้ำ เว็บนี้เป็นหน้าเดียวที่ใช้แค่ลิงก์ # จึงไม่ต้องใช้โหมดนั้น)
    "not_found_handling": "404-page"
  }
}
